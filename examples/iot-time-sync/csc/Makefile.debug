# Makefile for debugging in a host Linux platform
CC = gcc
CFLAGS = -Wall -Wextra -g -DCSC_INT_SIZE=8 -DCSC_NO_DIV_CHECK=1

# Define the source files, object files, and the final executable name
SOURCES1 = csc-debug1.c csc.c
SOURCES2 = csc-debug2.c csc.c
OBJECTS1 = $(SOURCES1:.c=.o)
OBJECTS2 = $(SOURCES2:.c=.o)
TARGET1 = csc-debug1
TARGET2 = csc-debug2

# optimize CSC implementation
DEFINES += CSC_INT_SIZE=4 # number of bytes for 'i', 'D', and 'A' (4 or 8)
# DEFINES += CSC_NO_ITER_COUNT=1 # turn off iteration couting in iterative algorithms
DEFINES += CSC_NO_DIV_CHECK=1 # turn off checking the value of A in division algorithms

# Default target: builds the program when 'make' is run
all: $(TARGET1) $(TARGET2)

# Rule to link object files into the 1st target
$(TARGET1): $(OBJECTS1)
	$(CC) $(OBJECTS1) -o $@ $(CFLAGS) -lm

# Rule to link object files into the 2nd target
$(TARGET2): $(OBJECTS2)
	$(CC) $(OBJECTS2) -o $@ $(CFLAGS) -lm

# Generic rule to compile .c files into .o files
# $@ is the target, $< is the first dependency
%.o: %.c csc.h
	$(CC) $(CFLAGS) -c $< -o $@

# Phony target for cleaning up generated files
.PHONY: clean
clean:
	rm -f $(TARGET1) $(OBJECTS1) $(TARGET2) $(OBJECTS2)
